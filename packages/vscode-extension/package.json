{
  "name": "dtl-language-support",
  "displayName": "DTL Language Support",
  "description": "Data Transformation Language (DTL) support for Sesam pipe configurations",
  "version": "0.1.0",
  "publisher": "bouvet",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "sesam",
    "dtl",
    "data transformation",
    "pipe",
    "integration"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/datanav/sesam-ts"
  },
  "main": "./dist/client/extension.js",
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:sesam-config"
  ],
  "contributes": {
    "iconThemes": [
      {
        "id": "sesam-icons",
        "label": "Sesam Icons",
        "path": "./fileicons/sesam-icon-theme.json"
      }
    ],
    "languages": [
      {
        "id": "sesam-config",
        "aliases": [
          "Sesam Config"
        ],
        "filenamePatterns": [
          "*.conf.json",
          "*.conf.pipe",
          "*.conf.system"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sesam-config",
        "scopeName": "source.sesam-config",
        "path": "./syntaxes/sesam-config.tmLanguage.json"
      },
      {
        "scopeName": "source.dtl.injection",
        "path": "./syntaxes/dtl-injection.tmLanguage.json",
        "injectTo": [
          "source.json",
          "source.sesam-config"
        ]
      }
    ],
    "snippets": [
      {
        "language": "json",
        "path": "./snippets/dtl.code-snippets.json"
      },
      {
        "language": "sesam-config",
        "path": "./snippets/dtl.code-snippets.json"
      }
    ],
    "commands": [
      {
        "command": "dtl.previewPipe",
        "title": "Sesam: Preview Pipe Output",
        "icon": "$(play)"
      },
      {
        "command": "dtl.openDocs",
        "title": "Sesam: Open Function Documentation"
      },
      {
        "command": "dtl.newConfFile",
        "title": "Sesam: New Sesam Config File",
        "icon": "$(new-file)"
      },
      {
        "command": "sesam.formatDocument",
        "title": "Sesam: Format Document",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "dtl.refreshDag",
        "title": "Sesam: Refresh Pipe DAG",
        "icon": "$(refresh)"
      },
      {
        "command": "sesam.clearErrors",
        "title": "Sesam: Clear Errors",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dtl.previewPipe",
          "when": "resourceLangId == json || resourceLangId == sesam-config",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "dtl.newConfFile",
          "when": "workspaceFolderCount > 0",
          "group": "2_workspace@99"
        }
      ],
      "commandPalette": [
        {
          "command": "dtl.newConfFile",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "sesam.formatDocument",
          "when": "editorLangId == sesam-config"
        },
        {
          "command": "sesam.clearErrors",
          "when": "workspaceFolderCount > 0"
        }
      ],
      "view/title": [
        {
          "command": "sesam.clearErrors",
          "when": "view == sesamErrorsList",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "sesamErrors",
          "title": "Sesam",
          "icon": "$(error)"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "sesamPipeLineage",
          "name": "Pipe Lineage",
          "when": "workspaceFolderCount > 0"
        },
        {
          "id": "sesamPipeDependents",
          "name": "Pipe Dependents",
          "when": "workspaceFolderCount > 0"
        },
        {
          "id": "sesamSystemPipes",
          "name": "System Pipes",
          "when": "workspaceFolderCount > 0"
        }
      ],
      "sesamErrors": [
        {
          "id": "sesamErrorsList",
          "name": "Sesam",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "DTL Language Support",
      "properties": {
        "dtl.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the DTL language server."
        },
        "dtl.maxNumberOfProblems": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of diagnostic problems reported per file."
        },
        "dtl.validate.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable DTL validation."
        },
        "dtl.validate.unknownFunctions": {
          "type": "boolean",
          "default": true,
          "description": "Report unknown DTL function names as errors."
        },
        "dtl.validate.argCount": {
          "type": "boolean",
          "default": true,
          "description": "Report incorrect argument counts as warnings."
        },
        "dtl.format.reorderKeys": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When saving a Sesam config file, reorder root-level keys to the canonical order documented by Sesam (`_id`, `type`, `source`, `transform`, `sink`, `pump`, …). Unknown keys are placed last, alphabetically. Set to `false` to preserve your original key order."
        },
        "dtl.graph.scanDepth": {
          "type": "number",
          "default": 3,
          "description": "Folder depth to scan for pipe config files in the workspace."
        },
        "sesam.nodeUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL of the Sesam node (e.g. https://abc123.sesam.cloud). Used to validate *.conf.json files against the node."
        },
        "sesam.jwt": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "JWT token for the Sesam node API. **Store this in user settings only — do NOT commit to `.vscode/settings.json`.**"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "echo 'This extension is for internal use only. Use vsce package + GitHub Releases instead.' && exit 1",
    "build": "vite build --config vite.config.client.ts && vite build --config vite.config.server.ts",
    "build:dev": "vite build --config vite.config.client.ts --mode development && vite build --config vite.config.server.ts --mode development",
    "watch": "vite build --config vite.config.client.ts --watch & vite build --config vite.config.server.ts --watch",
    "compile": "tsc -p client/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "lint": "eslint src client/src server/src",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package"
  },
  "dependencies": {
    "global": "^4.4.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^5.4.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.0"
  }
}
