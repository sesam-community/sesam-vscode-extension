{
  "name": "dtl-language-support",
  "displayName": "Sesam",
  "description": "Data Transformation Language (DTL) support for Sesam pipe configurations",
  "version": "0.1.0",
  "publisher": "bouvet",
  "icon": "fileicons/sesam-logo.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "sesam",
    "dtl",
    "data transformation",
    "pipe",
    "integration"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/datanav/sesam-ts"
  },
  "main": "./dist/client/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:json",
    "onLanguage:sesam-config",
    "onLanguageModelTool:sesam_lint_document",
    "onLanguageModelTool:sesam_lint_workspace",
    "onChatParticipant:sesam.agent"
  ],
  "contributes": {
    "chatParticipants": [
      {
        "id": "sesam.agent",
        "name": "sesam",
        "fullName": "Sesam Assistant",
        "description": "Sesam DTL and sesam-py expert — generate pipes, explain transforms, write tests",
        "isSticky": true,
        "commands": [
          {
            "name": "generate",
            "description": "Generate a new Sesam pipe config"
          },
          {
            "name": "explain",
            "description": "Explain the active DTL transform or pipe config"
          },
          {
            "name": "test",
            "description": "Generate test input/expected entities for the active pipe"
          },
          {
            "name": "cli",
            "description": "Get guidance on sesam-py CLI commands"
          },
          {
            "name": "fix",
            "description": "Fix validation errors in Sesam config files and apply changes to disk"
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "sesam_lint_document",
        "displayName": "Sesam: Lint Document",
        "toolReferenceName": "sesamLintDocument",
        "modelDescription": "Validates a Sesam DTL config file and returns structured diagnostics (errors and warnings). Accepts either a file URI / workspace-relative path or inline JSON content. Use this before suggesting fixes, writing configs to disk, or uploading to a Sesam node.",
        "canBeReferencedInPrompt": true,
        "icon": "$(check)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "uri": {
              "type": "string",
              "description": "File URI (file:///…) or workspace-relative path to the Sesam config file."
            },
            "content": {
              "type": "string",
              "description": "Raw JSON content to validate inline. Use when the file is unsaved or generated."
            },
            "filename": {
              "type": "string",
              "description": "Optional human-readable filename for inline content (display only)."
            }
          }
        }
      },
      {
        "name": "sesam_lint_workspace",
        "displayName": "Sesam: Lint Workspace",
        "toolReferenceName": "sesamLintWorkspace",
        "modelDescription": "Scans all Sesam config files in the workspace and returns a summary of all validation issues grouped by file. Use to audit the full config set before a sesam upload.",
        "canBeReferencedInPrompt": true,
        "icon": "$(list-errors)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "maxProblems": {
              "type": "number",
              "description": "Maximum total diagnostics to return. Default: 100."
            },
            "severity": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "all"
              ],
              "description": "Minimum severity to include. Default: 'all'."
            }
          }
        }
      }
    ],
    "iconThemes": [
      {
        "id": "sesam-icons",
        "label": "Sesam Icons",
        "path": "./fileicons/sesam-icon-theme.json"
      }
    ],
    "languages": [
      {
        "id": "sesam-config",
        "aliases": [
          "Sesam Config"
        ],
        "filenamePatterns": [
          "*.conf.json",
          "*.conf.pipe",
          "*.conf.system"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sesam-config",
        "scopeName": "source.sesam-config",
        "path": "./syntaxes/sesam-config.tmLanguage.json"
      },
      {
        "scopeName": "source.dtl.injection",
        "path": "./syntaxes/dtl-injection.tmLanguage.json",
        "injectTo": [
          "source.json",
          "source.sesam-config"
        ]
      }
    ],
    "snippets": [
      {
        "language": "json",
        "path": "./snippets/dtl.code-snippets.json"
      }
    ],
    "commands": [
      {
        "command": "sesam.setToken",
        "title": "Sesam: Set JWT Token"
      },
      {
        "command": "sesam.deleteToken",
        "title": "Sesam: Delete JWT Token"
      },
      {
        "command": "sesam.addProfile",
        "title": "Sesam: Add Profile"
      },
      {
        "command": "sesam.deleteProfile",
        "title": "Sesam: Delete Profile"
      },
      {
        "command": "sesam.listProfiles",
        "title": "Sesam: List Profiles"
      },
      {
        "command": "sesam.switchProfile",
        "title": "Sesam: Switch Profile"
      },
      {
        "command": "sesam.showProfiles",
        "title": "Sesam: Show Profiles"
      },
      {
        "command": "sesam.runPipeTests",
        "title": "Sesam: Run Pipe Tests",
        "icon": "$(beaker)",
        "enablement": "!sesam.testRunning"
      },
      {
        "command": "sesam.runPipe",
        "title": "Sesam: Run Pipe",
        "icon": {
          "light": "./fileicons/run-pipe.svg",
          "dark": "./fileicons/run-pipe.svg"
        }
      },
      {
        "command": "sesam.pipeRunningIndicator",
        "title": "Sesam: Pipe Running…",
        "icon": "$(sync~spin)"
      },
      {
        "command": "dtl.previewPipe",
        "title": "Sesam: Preview Pipe Output",
        "icon": {
          "light": "./fileicons/preview-pipe.svg",
          "dark": "./fileicons/preview-pipe.svg"
        }
      },
      {
        "command": "sesam.upload",
        "title": "Sesam: Upload to Node",
        "icon": {
          "light": "./fileicons/upload.svg",
          "dark": "./fileicons/upload.svg"
        }
      },
      {
        "command": "sesam.updateSnapshot",
        "title": "Sesam: Update Test Snapshot"
      },
      {
        "command": "sesam.download",
        "title": "Sesam: Download from Node",
        "icon": {
          "light": "./fileicons/download.svg",
          "dark": "./fileicons/download.svg"
        }
      },
      {
        "command": "dtl.openDocs",
        "title": "Sesam: Open Function Documentation"
      },
      {
        "command": "dtl.newConfFile",
        "title": "Sesam: New Sesam Config File",
        "icon": "$(new-file)"
      },
      {
        "command": "sesam.formatDocument",
        "title": "Sesam: Format Document",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "dtl.refreshDag",
        "title": "Sesam: Refresh Pipe DAG",
        "icon": "$(refresh)"
      },
      {
        "command": "sesam.clearErrors",
        "title": "Sesam: Clear Errors",
        "icon": "$(clear-all)"
      },
      {
        "command": "dtl.duplicatePipe",
        "title": "Sesam: Duplicate Config File"
      },
      {
        "command": "dtl.createDownstreamPipe",
        "title": "Sesam: Create Downstream Pipe"
      },
      {
        "command": "dtl.renamePipe",
        "title": "Sesam: Rename Config File"
      },
      {
        "command": "sesam.fixWithCopilot",
        "title": "Sesam: Fix with Copilot",
        "icon": "$(sparkle)"
      },
      {
        "command": "sesam.uploadFile",
        "title": "Sesam: Upload This Config to Node",
        "icon": "$(arrow-up)"
      },
      {
        "command": "sesam.downloadFile",
        "title": "Sesam: Download This Config from Node",
        "icon": "$(arrow-down)"
      },
      {
        "command": "sesam.pipeStatus",
        "title": "Sesam: Show Pipe Status",
        "icon": "$(pulse)"
      },
      {
        "command": "sesam.nodeStatus",
        "title": "Sesam: Open Node Status Panel",
        "icon": "$(server)"
      },
      {
        "command": "sesam.systemStatus",
        "title": "Sesam: Open System Status",
        "icon": "$(database)"
      },
      {
        "command": "sesam.showStatus",
        "title": "Sesam: Show Sync Status",
        "icon": "$(refresh)"
      },
      {
        "command": "sesam.viewDiff",
        "title": "Sesam: View Diff with Node",
        "icon": "$(diff)"
      },
      {
        "command": "sesam.revertConfig",
        "title": "Sesam: Revert to Remote Node Version",
        "icon": "$(discard)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "sesam.runPipe",
          "when": "(resourceLangId == json || resourceLangId == sesam-config) && !sesam.nodeProvisioning && !sesam.pipeRunning",
          "group": "navigation@1"
        },
        {
          "command": "sesam.pipeRunningIndicator",
          "when": "(resourceLangId == json || resourceLangId == sesam-config) && sesam.pipeRunning",
          "group": "navigation@1"
        },
        {
          "command": "sesam.pipeStatus",
          "when": "(resourceLangId == json || resourceLangId == sesam-config) && !sesam.nodeProvisioning",
          "group": "navigation@2"
        },
        {
          "command": "dtl.previewPipe",
          "when": "resourceLangId == json || resourceLangId == sesam-config",
          "group": "navigation@3"
        },
        {
          "command": "sesam.runPipeTests",
          "when": "(resourceLangId == json || resourceLangId == sesam-config) && !sesam.testRunning",
          "group": "navigation@3"
        },
        {
          "command": "sesam.uploadFile",
          "when": "(resourceLangId == json || resourceLangId == sesam-config) && !sesam.nodeProvisioning",
          "group": "navigation@4"
        },
        {
          "command": "sesam.downloadFile",
          "when": "(resourceLangId == json || resourceLangId == sesam-config) && !sesam.nodeProvisioning",
          "group": "navigation@5"
        },
        {
          "command": "sesam.upload",
          "when": "workspaceFolderCount > 0 && !sesam.nodeProvisioning",
          "group": "navigation@6"
        },
        {
          "command": "sesam.download",
          "when": "workspaceFolderCount > 0 && !sesam.nodeProvisioning",
          "group": "navigation@7"
        },
        {
          "command": "sesam.nodeStatus",
          "when": "workspaceFolderCount > 0 && !sesam.nodeProvisioning",
          "group": "navigation@8"
        },
        {
          "command": "sesam.fixWithCopilot",
          "when": "resourceLangId == json || resourceLangId == sesam-config",
          "group": "navigation@9"
        }
      ],
      "explorer/context": [
        {
          "command": "dtl.newConfFile",
          "when": "workspaceFolderCount > 0",
          "group": "2_workspace@99"
        },
        {
          "command": "dtl.duplicatePipe",
          "when": "resourceLangId == sesam-config",
          "group": "2_workspace@99"
        },
        {
          "command": "dtl.createDownstreamPipe",
          "when": "resourceLangId == sesam-config",
          "group": "2_workspace@99"
        },
        {
          "command": "dtl.renamePipe",
          "when": "resourceLangId == sesam-config",
          "group": "2_workspace@99"
        },
        {
          "command": "sesam.uploadFile",
          "when": "resourceLangId == sesam-config",
          "group": "2_workspace@99"
        },
        {
          "command": "sesam.downloadFile",
          "when": "resourceLangId == sesam-config",
          "group": "2_workspace@99"
        }
      ],
      "commandPalette": [
        {
          "command": "dtl.newConfFile",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "sesam.formatDocument",
          "when": "editorLangId == sesam-config"
        },
        {
          "command": "sesam.clearErrors",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "dtl.duplicatePipe",
          "when": "editorLangId == sesam-config"
        },
        {
          "command": "dtl.createDownstreamPipe",
          "when": "editorLangId == sesam-config"
        },
        {
          "command": "dtl.renamePipe",
          "when": "editorLangId == sesam-config"
        },
        {
          "command": "sesam.runPipe",
          "when": "editorLangId == sesam-config || editorLangId == json"
        },
        {
          "command": "sesam.upload",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "sesam.download",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "sesam.uploadFile",
          "when": "editorLangId == sesam-config || editorLangId == json"
        },
        {
          "command": "sesam.downloadFile",
          "when": "editorLangId == sesam-config || editorLangId == json"
        },
        {
          "command": "sesam.pipeStatus",
          "when": "editorLangId == sesam-config || editorLangId == json"
        },
        {
          "command": "sesam.nodeStatus",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "sesam.systemStatus",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "sesam.showStatus",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "sesam.revertConfig",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "sesam.clearErrors",
          "when": "view == sesamErrorsList",
          "group": "navigation"
        },
        {
          "command": "sesam.upload",
          "when": "view == workbench.explorer.fileView && workspaceFolderCount > 0 && !sesam.nodeProvisioning",
          "group": "navigation@10"
        },
        {
          "command": "sesam.download",
          "when": "view == workbench.explorer.fileView && workspaceFolderCount > 0 && !sesam.nodeProvisioning",
          "group": "navigation@11"
        },
        {
          "command": "sesam.nodeStatus",
          "when": "view == workbench.explorer.fileView && workspaceFolderCount > 0 && !sesam.nodeProvisioning",
          "group": "navigation@12"
        },
        {
          "command": "sesam.systemStatus",
          "when": "view == workbench.explorer.fileView && workspaceFolderCount > 0 && !sesam.nodeProvisioning",
          "group": "navigation@13"
        },
        {
          "command": "dtl.refreshDag",
          "when": "view == sesamPipeLineage",
          "group": "navigation@1"
        },
        {
          "command": "sesam.showStatus",
          "when": "view == sesamSyncStatus",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "sesam.viewDiff",
          "when": "viewItem == syncItem.modified || viewItem == syncItem.node-only",
          "group": "inline@1"
        },
        {
          "command": "sesam.revertConfig",
          "when": "viewItem == syncItem.modified",
          "group": "inline@2"
        }
      ],
      "viewsWelcome": []
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "sesamErrors",
          "title": "Sesam",
          "icon": "$(error)"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sesam.runPipe",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r"
      },
      {
        "command": "sesam.upload",
        "key": "ctrl+shift+u",
        "mac": "cmd+shift+u"
      },
      {
        "command": "sesam.download",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "sesamSyncStatus",
          "name": "Sesam Sync Status",
          "when": "workspaceFolderCount > 0"
        },
        {
          "id": "sesamPipeLineage",
          "name": "Pipe Lineage",
          "when": "workspaceFolderCount > 0"
        },
        {
          "id": "sesamPipeDependents",
          "name": "Pipe Dependents",
          "when": "workspaceFolderCount > 0"
        },
        {
          "id": "sesamSystemPipes",
          "name": "System Pipes",
          "when": "workspaceFolderCount > 0"
        }
      ],
      "sesamErrors": [
        {
          "id": "sesamErrorsList",
          "name": "Sesam",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "DTL Language Support",
      "properties": {
        "dtl.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the DTL language server."
        },
        "dtl.maxNumberOfProblems": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of diagnostic problems reported per file."
        },
        "dtl.validate.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable DTL validation."
        },
        "dtl.validate.unknownFunctions": {
          "type": "boolean",
          "default": true,
          "description": "Report unknown DTL function names as errors."
        },
        "dtl.validate.argCount": {
          "type": "boolean",
          "default": true,
          "description": "Report incorrect argument counts as warnings."
        },
        "dtl.format.reorderKeys": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When saving a Sesam config file, reorder root-level keys to the canonical order documented by Sesam (`_id`, `type`, `source`, `transform`, `sink`, `pump`, …). Unknown keys are placed last, alphabetically. Set to `false` to preserve your original key order."
        },
        "dtl.graph.scanDepth": {
          "type": "number",
          "default": 3,
          "description": "Folder depth to scan for pipe config files in the workspace."
        },
        "sesam.nodeUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL of the Sesam node (e.g. https://abc123.sesam.cloud). Used to validate *.conf.json files against the node."
        },
        "sesam.jwt": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "JWT token for the Sesam node API. **Store this in user settings only — do NOT commit to `.vscode/settings.json`.**"
        },
        "sesam.portal.verboseLogging": {
          "type": "boolean",
          "default": false,
          "description": "Log the full portal API response body in the Sesam output channel. Useful for debugging subscription/provisioning status issues."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node -e \"if (!process.env.CI) { console.error('This extension is for internal use only. Use vsce package + GitHub Releases instead.'); process.exit(1); }\"",
    "build": "vite build --config vite.config.client.ts && vite build --config vite.config.server.ts",
    "build:dev": "vite build --config vite.config.client.ts --mode development && vite build --config vite.config.server.ts --mode development",
    "watch": "vite build --config vite.config.client.ts --watch & vite build --config vite.config.server.ts --watch",
    "compile": "tsc -p client/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "lint": "eslint src client/src server/src",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package --no-dependencies --skip-license"
  },
  "dependencies": {
    "global": "^4.4.0",
    "socket.io-client": "^4.8.1",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@sesam/core": "workspace:*",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^5.4.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.0"
  }
}
